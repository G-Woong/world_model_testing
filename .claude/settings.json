{
  "showClearContextOnPlanAccept": true,
  "model": "opusplan",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NonInteractive -NoProfile -File .\\.claude\\hooks\\pre_tool_guard.ps1"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NonInteractive -NoProfile -File .\\.claude\\hooks\\post_edit_audit.ps1"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NonInteractive -NoProfile -File .\\.claude\\hooks\\stop_summary_guard.ps1"
          }
        ]
      }
    ]
  }
}
