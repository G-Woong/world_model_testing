.env

# =========================
# Python / environment
# =========================
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/

# =========================
# OS / IDE
# =========================
.DS_Store
Thumbs.db
.vscode/
.idea/

# =========================
# Large generated datasets
# =========================
data/*
!data/README.md
*.npz
*.npy
*.pkl
*.pickle
*.h5
*.hdf5
# Step 11: allow manifest/stats/quality metadata (not raw HDF5)
!data/fglc/**/manifest.json
!data/fglc/**/dataset_stats.json
!data/fglc/**/quality_report.json
!data/fglc/**/split_config.yaml

# =========================
# Training / evaluation outputs
# =========================
outputs/*
!outputs/README.md
runs/
wandb/
mlruns/
logs/
*.log
*.jsonl

# =========================
# Model checkpoints / weights
# =========================
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.onnx
*.gguf

# =========================
# Generated figures / temp artifacts
# =========================
*.png
*.jpg
*.jpeg
*.gif
*.pdf
*.csv

# =========================
# Secrets
# =========================
.env
.env.*
*.key
*.pem
secrets.*
*.token
*.secret
.mcp.secrets.json
secrets/

# =========================
# Claude Code session temp
# =========================
.claude/.session_*.lock
.claude/hooks/_logs/

# =========================
# P0 scaffold negations
# (negations moved next to the ignored patterns above, per git requirement)
# =========================

# =========================
# P2 additions
# =========================
# Keep phase gate sentinels (zero-byte marker files)
!outputs/phase_gates/
!outputs/phase_gates/*.passed
!outputs/test_reports/
!outputs/review_reports/
!outputs/eval_reports/

# =========================
# Claude / MCP local-only tooling
# =========================
.claude/
CLAUDE.md
CLAUDE.local.md
.mcp.json

# =========================
# Agent task harness
# =========================
.agent_tasks/codex_logs/
.agent_tasks/.lock

# =========================
# STEP 10 risk_hunt outputs - keep gitkeep markers
# =========================
!outputs/risk_hunt/
!outputs/risk_hunt/**/.gitkeep

# =========================
# Lifecycle Automation v2 (Phase 1 reservation)
# =========================
# outputs/lifecycle/ — generated audit output (only .gitkeep tracked)
!outputs/lifecycle/
outputs/lifecycle/*
!outputs/lifecycle/.gitkeep

# .lifecycle_trash/ — quarantined files (only .gitkeep tracked)
.lifecycle_trash/*
!.lifecycle_trash/.gitkeep

# .self_evolving_memory/ — Phase 2: run_summaries/ auto-generated, ignored
.self_evolving_memory/run_summaries/*
!.self_evolving_memory/run_summaries/.gitkeep
# hook_execution_log.md remains tracked (audit trail in chore(turn) commits)
!outputs/repair/.gitkeep
